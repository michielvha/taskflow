{
  "name": "taskflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "date-fns": "^4",
    "lucide-react": "^0.460",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3",
    "wa-sqlite": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@tailwindcss/vite": "^4",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7",
    "eslint-plugin-react-refresh": "^0.5",
    "eslint-plugin-security": "^3",
    "globals": "^17",
    "jsdom": "^26",
    "tailwindcss": "^4",
    "typescript": "~5.9",
    "typescript-eslint": "^8",
    "vite": "^7",
    "vitest": "^3"
  }
